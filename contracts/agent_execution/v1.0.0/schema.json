{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factoryops.dev/contracts/agent-execution/1.0.0/schema.json",
  "title": "FactoryOps Agent Execution Contract 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "identity", "provenance", "input", "lifecycle", "result", "failure"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "identity": {
      "title": "Agent Execution Identity",
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_id", "execution_key", "run_id", "agent_role", "attempt"],
      "properties": {
        "execution_id": {"$ref": "#/$defs/executionId"},
        "execution_key": {"$ref": "#/$defs/executionKey"},
        "run_id": {"$ref": "#/$defs/runId"},
        "agent_role": {"enum": ["coordinator", "quality", "production", "sla", "risk"]},
        "attempt": {"type": "integer", "minimum": 1, "maximum": 2147483647}
      }
    },
    "provenance": {
      "title": "Agent Execution Provenance",
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_version", "prompt_version", "model_policy_version", "tool_policy_version", "context_policy_version", "code_revision", "created_at"],
      "properties": {
        "runtime_version": {"$ref": "#/$defs/versionReference"},
        "prompt_version": {"$ref": "#/$defs/versionReference"},
        "model_policy_version": {"$ref": "#/$defs/versionReference"},
        "tool_policy_version": {"$ref": "#/$defs/versionReference"},
        "context_policy_version": {"$ref": "#/$defs/versionReference"},
        "code_revision": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
        "created_at": {"$ref": "#/$defs/utcTimestamp"}
      }
    },
    "input": {
      "title": "Agent Execution Input References",
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "context_snapshot_id", "evidence_refs"],
      "properties": {
        "task_id": {"$ref": "#/$defs/nullableTaskId"},
        "context_snapshot_id": {"$ref": "#/$defs/contextSnapshotId"},
        "evidence_refs": {"$ref": "#/$defs/referenceArray"}
      }
    },
    "lifecycle": {
      "title": "Agent Execution Lifecycle",
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "revision", "updated_at", "status_reason"],
      "properties": {
        "status": {"enum": ["PENDING", "RUNNING", "SUCCEEDED", "FAILED", "CANCELLED"]},
        "revision": {"type": "integer", "minimum": 0},
        "updated_at": {"$ref": "#/$defs/utcTimestamp"},
        "started_at": {"$ref": "#/$defs/utcTimestamp"},
        "ended_at": {"$ref": "#/$defs/utcTimestamp"},
        "status_reason": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/statusReason"}]}
      }
    },
    "result": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/executionResult"}]},
    "failure": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/executionFailure"}]}
  },
  "allOf": [
    {
      "if": {"properties": {"lifecycle": {"properties": {"status": {"const": "PENDING"}}, "required": ["status"]}}},
      "then": {"properties": {"lifecycle": {"not": {"anyOf": [{"required": ["started_at"]}, {"required": ["ended_at"]}]}}, "result": {"type": "null"}, "failure": {"type": "null"}}}
    },
    {
      "if": {"properties": {"lifecycle": {"properties": {"status": {"const": "RUNNING"}}, "required": ["status"]}}},
      "then": {"properties": {"lifecycle": {"required": ["started_at"], "not": {"required": ["ended_at"]}}, "result": {"type": "null"}, "failure": {"type": "null"}}}
    },
    {
      "if": {"properties": {"lifecycle": {"properties": {"status": {"const": "SUCCEEDED"}}, "required": ["status"]}}},
      "then": {"properties": {"lifecycle": {"required": ["started_at", "ended_at"]}, "result": {"$ref": "#/$defs/executionResult"}, "failure": {"type": "null"}}}
    },
    {
      "if": {"properties": {"lifecycle": {"properties": {"status": {"const": "FAILED"}}, "required": ["status"]}}},
      "then": {"properties": {"lifecycle": {"required": ["started_at", "ended_at"]}, "result": {"type": "null"}, "failure": {"$ref": "#/$defs/executionFailure"}}}
    },
    {
      "if": {"properties": {"lifecycle": {"properties": {"status": {"const": "CANCELLED"}}, "required": ["status"]}}},
      "then": {"properties": {"lifecycle": {"required": ["ended_at"]}, "result": {"type": "null"}, "failure": {"type": "null"}}}
    }
  ],
  "$defs": {
    "executionId": {"type": "string", "pattern": "^EXE-[0-9A-F]{32}$"},
    "executionKey": {"type": "string", "pattern": "^EXK-[0-9A-F]{64}$"},
    "runId": {"type": "string", "pattern": "^RUN-[0-9A-F]{32}$"},
    "taskId": {"type": "string", "pattern": "^TSK-[0-9A-F]{32}$"},
    "nullableTaskId": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/taskId"}]},
    "contextSnapshotId": {"type": "string", "pattern": "^CTX-[0-9A-F]{32}$"},
    "versionReference": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "reference": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "referenceArray": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/reference"}},
    "utcTimestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$"},
    "statusReason": {
      "title": "Agent Execution Status Reason",
      "type": "object", "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[A-Z][A-Z0-9_]*$"},
        "message": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "executionResult": {
      "title": "Agent Execution Result",
      "type": "object", "additionalProperties": false,
      "required": ["output_artifact_refs", "decision_id", "evidence_refs"],
      "properties": {
        "output_artifact_refs": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/reference"}},
        "decision_id": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^DEC-[0-9A-F]{32}$"}]},
        "evidence_refs": {"$ref": "#/$defs/referenceArray"}
      }
    },
    "executionFailure": {
      "title": "Agent Execution Failure",
      "type": "object", "additionalProperties": false,
      "required": ["code", "message", "recoverability", "failed_dependency_ref"],
      "properties": {
        "code": {"type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[A-Z][A-Z0-9_]*$"},
        "message": {"type": "string", "minLength": 1, "maxLength": 500},
        "recoverability": {"enum": ["retryable", "non_retryable"]},
        "failed_dependency_ref": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/reference"}]}
      }
    }
  }
}
