{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://factoryops.dev/contracts/coordinator-fusion/1.0.0/schema.json",
  "type":"object","additionalProperties":false,
  "required":["contract_version","identity","inputs","fusion","generated_at"],
  "properties":{
    "contract_version":{"const":"1.0.0"},
    "identity":{"type":"object","additionalProperties":false,"required":["fusion_id","fusion_key","run_id","coordinator_execution_id","round"],"properties":{
      "fusion_id":{"type":"string","pattern":"^FUS-[0-9A-F]{32}$"},
      "fusion_key":{"type":"string","pattern":"^FUK-[0-9A-F]{64}$"},
      "run_id":{"type":"string","pattern":"^RUN-[0-9A-F]{32}$"},
      "coordinator_execution_id":{"type":"string","pattern":"^EXE-[0-9A-F]{32}$"},
      "round":{"type":"integer","minimum":1,"maximum":1000}
    }},
    "inputs":{"type":"object","additionalProperties":false,"required":["recommendations","missing_roles"],"properties":{
      "recommendations":{"type":"array","minItems":2,"maxItems":3,"items":{"$ref":"#/$defs/recommendation_ref"}},
      "missing_roles":{"type":"array","maxItems":1,"items":{"$ref":"#/$defs/role"}}
    }},
    "fusion":{"type":"object","additionalProperties":false,"required":["proposed_action","authorization_state","candidates","has_conflict","conflict_codes","evidence_refs","reason_codes"],"properties":{
      "proposed_action":{"$ref":"#/$defs/action"},
      "authorization_state":{"const":"NOT_EVALUATED"},
      "candidates":{"type":"array","minItems":1,"maxItems":6,"items":{"$ref":"#/$defs/candidate"}},
      "has_conflict":{"type":"boolean"},
      "conflict_codes":{"type":"array","maxItems":16,"items":{"$ref":"#/$defs/code"}},
      "evidence_refs":{"type":"array","minItems":1,"maxItems":64,"items":{"$ref":"#/$defs/reference"}},
      "reason_codes":{"type":"array","minItems":1,"maxItems":32,"items":{"$ref":"#/$defs/code"}}
    }},
    "generated_at":{"$ref":"#/$defs/timestamp"}
  },
  "$defs":{
    "role":{"enum":["quality","production","sla"]},
    "action":{"enum":["PASS","RECHECK","REJECT_ITEM","HOLD_BATCH","STOP_LINE","ESCALATE"]},
    "severity":{"enum":["LOW","MEDIUM","HIGH","CRITICAL"]},
    "code":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,127}$"},
    "reference":{"type":"string","minLength":1,"maxLength":255,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "timestamp":{"type":"string","format":"date-time","pattern":"^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$"},
    "recommendation_ref":{"type":"object","additionalProperties":false,"required":["recommendation_id","recommendation_key","execution_id","task_id","agent_role","action","severity","confidence"],"properties":{
      "recommendation_id":{"type":"string","pattern":"^REC-[0-9A-F]{32}$"},
      "recommendation_key":{"type":"string","pattern":"^RCK-[0-9A-F]{64}$"},
      "execution_id":{"type":"string","pattern":"^EXE-[0-9A-F]{32}$"},
      "task_id":{"type":"string","pattern":"^TSK-[0-9A-F]{32}$"},
      "agent_role":{"$ref":"#/$defs/role"},
      "action":{"$ref":"#/$defs/action"},
      "severity":{"$ref":"#/$defs/severity"},
      "confidence":{"type":"number","minimum":0,"maximum":1}
    }},
    "candidate":{"type":"object","additionalProperties":false,"required":["action","rank","score","supporting_roles","opposing_roles"],"properties":{
      "action":{"$ref":"#/$defs/action"},
      "rank":{"type":"integer","minimum":1,"maximum":6},
      "score":{"type":"number","minimum":0,"maximum":1},
      "supporting_roles":{"type":"array","maxItems":3,"items":{"$ref":"#/$defs/role"}},
      "opposing_roles":{"type":"array","maxItems":3,"items":{"$ref":"#/$defs/role"}}
    }}
  }
}
