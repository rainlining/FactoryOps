{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factoryops.dev/contracts/human-approval/1.0.0/schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "identity", "request", "state"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["approval_id", "approval_key", "decision_id", "decision_key", "fusion_id", "fusion_key", "run_id", "coordinator_execution_id", "round"],
      "properties": {
        "approval_id": {"type": "string", "pattern": "^APR-[0-9A-F]{32}$"},
        "approval_key": {"type": "string", "pattern": "^APK-[0-9A-F]{64}$"},
        "decision_id": {"type": "string", "pattern": "^RSK-[0-9A-F]{32}$"},
        "decision_key": {"type": "string", "pattern": "^RDK-[0-9A-F]{64}$"},
        "fusion_id": {"type": "string", "pattern": "^FUS-[0-9A-F]{32}$"},
        "fusion_key": {"type": "string", "pattern": "^FUK-[0-9A-F]{64}$"},
        "run_id": {"type": "string", "pattern": "^RUN-[0-9A-F]{32}$"},
        "coordinator_execution_id": {"type": "string", "pattern": "^EXE-[0-9A-F]{32}$"},
        "round": {"type": "integer", "minimum": 1, "maximum": 1000}
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["proposed_action", "risk_level", "policy_refs", "reason_codes", "requested_at", "expires_at"],
      "properties": {
        "proposed_action": {"enum": ["REJECT_ITEM", "HOLD_BATCH", "STOP_LINE"]},
        "risk_level": {"enum": ["MEDIUM", "HIGH"]},
        "policy_refs": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/reference"}},
        "reason_codes": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"}},
        "requested_at": {"$ref": "#/$defs/timestamp"},
        "expires_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "status"],
      "properties": {
        "revision": {"type": "integer", "minimum": 1, "maximum": 2},
        "status": {"enum": ["PENDING", "APPROVED", "REJECTED", "EXPIRED"]},
        "outcome": {
          "type": "object", "additionalProperties": false,
          "required": ["actor_type", "actor_id", "decided_at", "reason_code"],
          "properties": {
            "actor_type": {"enum": ["HUMAN", "SYSTEM"]},
            "actor_id": {"type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]*$"},
            "decided_at": {"$ref": "#/$defs/timestamp"},
            "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"},
            "comment_ref": {"$ref": "#/$defs/reference"}
          }
        }
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "PENDING"}}}, "then": {"properties": {"revision": {"const": 1}}, "not": {"required": ["outcome"]}}},
        {"if": {"properties": {"status": {"enum": ["APPROVED", "REJECTED", "EXPIRED"]}}}, "then": {"properties": {"revision": {"const": 2}}, "required": ["outcome"]}}
      ]
    }
  },
  "$defs": {
    "reference": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$"}
  }
}
