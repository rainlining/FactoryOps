{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://factoryops.dev/contracts/risk-decision/1.0.0/schema.json",
  "type":"object","additionalProperties":false,
  "required":["contract_version","identity","gate","generated_at"],
  "properties":{
    "contract_version":{"const":"1.0.0"},
    "identity":{"type":"object","additionalProperties":false,"required":["decision_id","decision_key","recommendation_id","recommendation_key","run_id","task_id"],"properties":{
      "decision_id":{"type":"string","pattern":"^RSK-[0-9A-F]{32}$"},
      "decision_key":{"type":"string","pattern":"^RDK-[0-9A-F]{64}$"},
      "recommendation_id":{"type":"string","pattern":"^REC-[0-9A-F]{32}$"},
      "recommendation_key":{"type":"string","pattern":"^RCK-[0-9A-F]{64}$"},
      "run_id":{"type":"string","pattern":"^RUN-[0-9A-F]{32}$"},
      "task_id":{"type":"string","pattern":"^TSK-[0-9A-F]{32}$"}
    }},
    "gate":{"type":"object","additionalProperties":false,"required":["proposed_action","decision","risk_level","approval_required","allowed_actions","policy_refs","reason_codes","confidence"],"properties":{
      "proposed_action":{"$ref":"#/$defs/action"},
      "decision":{"enum":["ALLOW","BLOCK","REQUIRE_APPROVAL"]},
      "risk_level":{"enum":["LOW","MEDIUM","HIGH"]},
      "approval_required":{"type":"boolean"},
      "allowed_actions":{"type":"array","maxItems":6,"items":{"$ref":"#/$defs/action"}},
      "policy_refs":{"type":"array","minItems":1,"maxItems":32,"items":{"$ref":"#/$defs/reference"}},
      "reason_codes":{"type":"array","minItems":1,"maxItems":32,"items":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,127}$"}},
      "confidence":{"type":"number","minimum":0,"maximum":1}
    }},
    "generated_at":{"$ref":"#/$defs/timestamp"}
  },
  "$defs":{
    "action":{"enum":["PASS","RECHECK","REJECT_ITEM","HOLD_BATCH","STOP_LINE","ESCALATE"]},
    "reference":{"type":"string","minLength":1,"maxLength":255,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "timestamp":{"type":"string","format":"date-time","pattern":"^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$"}
  }
}
