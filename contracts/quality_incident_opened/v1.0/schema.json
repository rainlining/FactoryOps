{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factoryops.dev/contracts/quality-incident-opened/1.0/schema.json",
  "title": "FactoryOps Quality Incident Opened Event 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "event_id",
    "event_type",
    "occurred_at",
    "producer",
    "aggregate",
    "correlation_id",
    "causation_id",
    "payload"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "pattern": "^EVT-[0-9A-F]{64}$"
    },
    "event_type": {
      "const": "quality.incident.opened"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "const": "factoryops-business-service"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "const": "quality-incident"
        },
        "id": {
          "$ref": "#/$defs/incidentId"
        }
      }
    },
    "correlation_id": {
      "$ref": "#/$defs/incidentId"
    },
    "causation_id": {
      "$ref": "#/$defs/businessId"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incident_schema_version",
        "incident_id",
        "status",
        "batch_id",
        "inspection_id",
        "result_id"
      ],
      "properties": {
        "incident_schema_version": {
          "const": "1.0"
        },
        "incident_id": {
          "$ref": "#/$defs/incidentId"
        },
        "status": {
          "const": "OPEN"
        },
        "batch_id": {
          "$ref": "#/$defs/businessId"
        },
        "inspection_id": {
          "$ref": "#/$defs/businessId"
        },
        "result_id": {
          "$ref": "#/$defs/businessId"
        }
      }
    }
  },
  "$defs": {
    "incidentId": {
      "type": "string",
      "pattern": "^QI-[0-9A-F]{64}$"
    },
    "businessId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    }
  }
}
