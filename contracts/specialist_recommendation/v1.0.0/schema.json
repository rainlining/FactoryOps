{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factoryops.dev/contracts/specialist-recommendation/1.0.0/schema.json",
  "title": "FactoryOps Specialist Recommendation Contract 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "identity", "recommendation", "details", "generated_at"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["recommendation_id", "recommendation_key", "execution_id", "run_id", "task_id", "agent_role"],
      "properties": {
        "recommendation_id": {"type": "string", "pattern": "^REC-[0-9A-F]{32}$"},
        "recommendation_key": {"type": "string", "pattern": "^RCK-[0-9A-F]{64}$"},
        "execution_id": {"type": "string", "pattern": "^EXE-[0-9A-F]{32}$"},
        "run_id": {"type": "string", "pattern": "^RUN-[0-9A-F]{32}$"},
        "task_id": {"type": "string", "pattern": "^TSK-[0-9A-F]{32}$"},
        "agent_role": {"enum": ["quality", "production", "sla"]}
      }
    },
    "recommendation": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "severity", "confidence", "evidence_refs", "reason_codes", "output_artifact_refs"],
      "properties": {
        "action": {"$ref": "#/$defs/action"},
        "severity": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/reference"}},
        "reason_codes": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[A-Z][A-Z0-9_]*$"}},
        "output_artifact_refs": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/reference"}}
      }
    },
    "details": {"type": "object"},
    "generated_at": {"$ref": "#/$defs/utcTimestamp"}
  },
  "allOf": [
    {
      "if": {"properties": {"identity": {"properties": {"agent_role": {"const": "quality"}}, "required": ["agent_role"]}}},
      "then": {"properties": {"details": {"$ref": "#/$defs/qualityDetails"}}}
    },
    {
      "if": {"properties": {"identity": {"properties": {"agent_role": {"const": "production"}}, "required": ["agent_role"]}}},
      "then": {"properties": {"details": {"$ref": "#/$defs/productionDetails"}}}
    },
    {
      "if": {"properties": {"identity": {"properties": {"agent_role": {"const": "sla"}}, "required": ["agent_role"]}}},
      "then": {"properties": {"details": {"$ref": "#/$defs/slaDetails"}}}
    }
  ],
  "$defs": {
    "action": {"enum": ["PASS", "RECHECK", "REJECT_ITEM", "HOLD_BATCH", "STOP_LINE", "ESCALATE"]},
    "reference": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"},
    "utcTimestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$"},
    "qualityDetails": {
      "type": "object", "additionalProperties": false,
      "required": ["consecutive_defect_suspected"],
      "properties": {"consecutive_defect_suspected": {"type": "boolean"}}
    },
    "productionDetails": {
      "type": "object", "additionalProperties": false,
      "required": ["estimated_delay_minutes", "estimated_downtime_minutes", "affected_order_refs"],
      "properties": {
        "estimated_delay_minutes": {"type": "integer", "minimum": 0, "maximum": 525600},
        "estimated_downtime_minutes": {"type": "integer", "minimum": 0, "maximum": 525600},
        "affected_order_refs": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/reference"}}
      }
    },
    "slaDetails": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_cost", "currency", "alternative_costs"],
      "properties": {
        "expected_cost": {"type": "number", "minimum": 0, "maximum": 1000000000000},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "alternative_costs": {
          "type": "object", "additionalProperties": false, "minProperties": 1,
          "properties": {
            "PASS": {"$ref": "#/$defs/cost"}, "RECHECK": {"$ref": "#/$defs/cost"},
            "REJECT_ITEM": {"$ref": "#/$defs/cost"}, "HOLD_BATCH": {"$ref": "#/$defs/cost"},
            "STOP_LINE": {"$ref": "#/$defs/cost"}, "ESCALATE": {"$ref": "#/$defs/cost"}
          }
        }
      }
    },
    "cost": {"type": "number", "minimum": 0, "maximum": 1000000000000}
  }
}
